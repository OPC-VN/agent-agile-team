{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/agile_hook.py", "--format", "claude"], "timeout": 10 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/agile_hook.py", "--format", "claude"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/agile_guard.py", "--format", "claude"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/agile_guard.py", "--format", "claude"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/tier_hook.py"], "timeout": 10 }
        ]
      }
    ]
  }
}
